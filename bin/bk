#!/bin/bash
# bk — bk shell: workspace de agentes de Barrilete Kit en la terminal (tmux + Claude Code).
# Cada agente corre en una ventana de la sesión tmux "agents", con BARRILETE_ROLE/MODEL/ISSUE
# en el entorno (la barra de Sketchybar lo etiqueta con eso).
set -euo pipefail

WS="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SESSION="${BK_SESSION:-agents}"
STATE_DIR="${BK_STATE_DIR:-$HOME/.cache/bk/agents}"
export BK_STATE_DIR="$STATE_DIR"   # lib/agents.py lee el mismo estado
DRY=0
TASKS="$WS/lib/tasks.py"   # tareas de los agentes (ADR-005 del kit): task.json + events.jsonl

# Los atajos de tmux pasan BK_FROM/BK_CLIENT a los popups, pero el comando de display-popup no
# expande #{…}: llegan literales. Sin un valor real, tomarlos del cliente de tmux actual.
if [ -n "${TMUX:-}" ]; then
  case "${BK_FROM:-}" in *'#{'*) BK_FROM=$(tmux display-message -p '#{session_name}' 2>/dev/null || true); export BK_FROM ;; esac
  case "${BK_CLIENT:-}" in *'#{'*) BK_CLIENT=$(tmux display-message -p '#{client_name}' 2>/dev/null || true); export BK_CLIENT ;; esac
fi

die()  { printf 'bk: %s\n' "$*" >&2; exit 1; }
info() { printf '\033[2m%s\033[0m\n' "$*"; }

usage() {
  cat <<'EOF'
uso: bk [comando] [--dry-run]

  (sin comando)     el workspace del proyecto de esta carpeta: chat + riel (sesión tmux "bk-<proyecto>";
                    si ya existe, vuelve a ella). Uno por proyecto, cada uno en su escritorio
  rerun [--go] [pr…]  volver a correr los checks de Actions que fallaron (sin --go: solo muestra)
  new | n           popup "Nuevo": chat nuevo en este proyecto u otro workspace (alt+n, o + en la tira)
  chat [--suelto]   otro chat del proyecto, como un workspace más en la tira (alt+N); --suelto: sin
                    proyecto, en el lugar del chat (alt+q vuelve)
  chat --rama N     otro chat en su propio worktree y rama chat/N (desde la rama principal); si existe, lo reusa
  chat --nombre X   el chat nuevo se llama X (bk ls, bk say X "…", bk go X); también con --rama
  name ["nombre"]   nombrar el chat de este workspace (sin nombre: el de /rename o el título de Claude; - lo borra)
  open [proyecto]   abrir el workspace de otro proyecto en una ventana nueva (sin argumento: los abiertos)
  plan "<idea>"     planner: /plan-feature en la raíz del proyecto
  run <issue>       routing.py elige el rol → prepare.sh crea worktree → implementer en tmux
                    (--role implementer|implementer-light para forzarlo; --orchestrated si lo lanza
                    /orchestrate: el orquestador lanza al reviewer y bk no lo propone)
  review <pr>       reviewer: /review-pr en la raíz del proyecto
  fix <pr> "…"      implementer sobre la rama de un PR abierto (su worktree), con la instrucción dada
                    (--role implementer-light para usar el liviano)
  orchestrate       orchestrator: /orchestrate (reparte hasta 3 issues como subagentes)
  ls [--all]        agentes con el título de su issue/PR, los que te esperan primero (--all: todas las sesiones)
  go <agente>       saltar a un agente. <agente>: la ventana (i42, pr57), un número (#240) o una palabra del título
  changes           lo que los agentes dejaron sin commitear, con diff (alt+g)
  palette | k       todos los comandos con búsqueda (alt+k)
  monitor           pantalla para el otro monitor: qué te espera, agentes, tareas, costo y desvíos en vivo (los graves suenan)
                    (c o bk monitor --clear limpian los desvíos: lo anterior no vuelve aunque relea los transcripts)
  stats             estadísticas de uso: actividad, modelos, rachas, costo (alt+u)
  customize         estilo del workspace: tarjetas float/neon, densidad, header, tema (alt+,)
  s                 sesiones de Claude estilo Orca: abiertas (saltar) y recientes de todas las
                    carpetas (retomar con claude --resume). En tmux: prefijo + s
  peek [ventana] [n] ver qué hace un agente sin entrar (sin ventana: todos, últimas líneas)
  say [agente] "…"  escribirle a un agente (o a un chat por su nombre) como si estuvieras ahí; sin agente, al que te espera.
                    Si el agente está trabajando, se encola y se escribe al terminar su turno (--now: ya)
  watch [ventana]   pantalla de un agente en vivo, solo lectura (sin ventana: toma el próximo
                    agente que nadie esté mirando; --all: todos en un panel, como en el workspace)
  stop <agente>     cerrar la ventana del agente (el worktree queda; su tarea queda cancelada)
  done <resultado>  (lo corre el agente) cerrar su tarea: pr <n> | blockers | dropped "…" | escalate "…"
  tasks [--all]     las tareas de los agentes con su estado, su resultado y su carpeta
  tasks prune [--days N] [--yes]  borrar tareas terminadas (nunca las activas; sin --yes solo muestra)
  approve <tarea>   lanzar una tarea propuesta (el reviewer de un PR, pr<n>-reviewer)
  checkpoints [--json]  lo que te espera: planes por aprobar, reviewers propuestos, PRs para revisar o
                    mergear y lecciones propuestas (lo mismo que "Te esperan" en bk monitor)
  roles             qué provider/modelo corre cada rol en este proyecto, y su modo
  account           cuentas de Claude o Codex por sesión, con las mismas conversaciones (bk account help):
                    new <claude|codex> <nombre> · use <nombre> [--relaunch] · --account <nombre> en
                    cualquier lanzamiento
  sound [on|off|test]  sonido por tipo de pedido de los agentes: terminó, pregunta, permiso, error
  song [género]     radio por género (techno, house, rock, reggaeton, cachengue), tuya o cualquier url (bk song help)
  mode <rol>        cómo lo lanza el orquestador: main (la sesión principal), bk (ventana propia) o
                    sub (subagente); 3.ª columna de roles.yml, bk si no tiene
  sub [transcript]  ver en vivo un subagente, solo lectura (sin argumento: elegir de los vivos); también
                    con clic en una fila └ de la tira
  term [dir]        terminal rápida del proyecto, persistente (alt+x la muestra y la esconde)
  tokens            tokens del día y costo equivalente en API, por modelo y proyecto

Los comandos de agentes se corren dentro de un proyecto Barrilete.
EOF
}

# ---------- proyecto y roles ----------
project_root() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "no estás en un repo git"
  [ -f "$root/scripts/agents/guardrails.py" ] || die "$root no es un proyecto Barrilete (falta scripts/agents/guardrails.py)"
  printf '%s' "$root"
}

# role_spec <rol> [root] -> "provider/modelo"
role_spec() {
  local role="$1" root="${2:-}" f spec=""
  for f in ${root:+"$root/.barrilete/roles.yml"} "$WS/roles.yml"; do
    [ -f "$f" ] || continue
    spec=$(sed -nE "s/^[[:space:]]*${role}:[[:space:]]*([^#[:space:]]+).*/\1/p" "$f" | head -1)
    [ -n "$spec" ] && break
  done
  [ -n "$spec" ] || die "el rol '$role' no está en roles.yml"
  printf '%s' "$spec"
}

# agent_cmd <provider> <modelo> <prompt> -> comando a correr en el pane
# Comillas simples a mano: el printf %q de bash 3.2 rompe los acentos (í → $'\255')
sq() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }

agent_cmd() {
  local provider="$1" model="$2" prompt="$3"
  prompt=$(sq "$prompt")
  case "$provider" in
    claude) printf 'claude --model %q %s' "$model" "$prompt" ;;
    codex)
      command -v codex >/dev/null || die "provider codex: Codex CLI no está instalado"
      # Codex no lee .claude/settings.json: las barandas de guardrails.py NO aplican acá.
      printf 'codex -m %q %s' "$model" "$prompt" ;;
    *) die "provider desconocido: $provider (claude | codex)" ;;
  esac
}

# ---------- cuentas por sesión (bk-shell#16) ----------
# Cada cuenta es una carpeta de config (CLAUDE_CONFIG_DIR / CODEX_HOME) que comparte las conversaciones
# con la principal (lib/accounts.py). La sesión de tmux guarda la elegida en @bk_account_<proveedor>;
# los agentes la heredan por BK_ACCOUNT_<PROVEEDOR> en su pane.
ACCOUNTS="$WS/lib/accounts.py"
upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

# La sesión de tmux desde donde se llama (los popups pasan BK_FROM)
caller_session() {
  [ -n "${TMUX:-}" ] || return 0
  if [ -n "${BK_FROM:-}" ]; then printf '%s' "$BK_FROM"; return; fi
  tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{session_name}' 2>/dev/null || true
}

# account_of <proveedor> -> la cuenta para lo que se lance desde acá (vacío: la principal)
# Orden: bk … --account X (BK_ACCOUNT) > la del pane (la heredan los agentes) > la de la sesión de tmux.
account_of() {
  local prov="$1" v="" s
  if [ -n "${BK_ACCOUNT:-}" ]; then
    [ "$BK_ACCOUNT" = default ] && return 0
    [ "$(python3 "$ACCOUNTS" provider "$BK_ACCOUNT")" = "$prov" ] && { printf '%s' "$BK_ACCOUNT"; return; }
  fi
  eval "v=\${BK_ACCOUNT_$(upper "$prov"):-}"
  if [ -z "$v" ]; then
    s=$(caller_session)
    [ -z "$s" ] || v=$(tmux show-options -qv -t "$s" "@bk_account_$prov" 2>/dev/null || true)
  fi
  [ "$v" = default ] || printf '%s' "$v"
}

# account_env <proveedor> -> líneas VAR=valor para tmux -e (nada si es la principal)
account_env() {
  local prov="$1" c; c=$(account_of "$prov")
  [ -n "$c" ] || return 0
  python3 "$ACCOUNTS" env "$c" || die "la cuenta $c no existe (bk account)"
  printf 'BK_ACCOUNT_%s=%s\n' "$(upper "$prov")" "$c"
}

# account_args <proveedor>: llena el array CTA (declaralo local antes) con los -e de la cuenta
account_args() {
  local out kv; out=$(account_env "$1") || exit 1
  CTA=()
  while IFS= read -r kv; do [ -z "$kv" ] || CTA+=(-e "$kv"); done <<<"$out"
}

cmd_account() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    ""|ls|list)
      local s c x; s=$(caller_session)
      python3 "$ACCOUNTS" list
      if [ -n "$s" ]; then
        c=$(tmux show-options -qv -t "$s" @bk_account_claude 2>/dev/null || true)
        x=$(tmux show-options -qv -t "$s" @bk_account_codex 2>/dev/null || true)
        info "en $s: claude ${c:-default} · codex ${x:-default}"
      fi ;;
    new)
      local prov="${1:-}" name="${2:-}"
      [ -n "$prov" ] && [ -n "$name" ] || die "bk account new <claude|codex> <nombre>"
      [ "$DRY" -eq 1 ] && { info "(dry-run: crearía la cuenta $prov/$name)"; return 0; }
      python3 "$ACCOUNTS" new "$prov" "$name" >/dev/null || exit 1
      info "cuenta $name creada: ahora el login de $prov (las conversaciones son las mismas de siempre)"
      account_login "$name" ;;
    login)
      [ -n "${1:-}" ] || die "bk account login <nombre>"
      account_login "$1" ;;
    use)
      account_use "$@" ;;
    -h|--help|help)
      cat <<'EOF'
uso: bk account                       las cuentas (● con sesión iniciada) y las de esta sesión
     bk account new <claude|codex> <nombre>   crear una cuenta y hacer su login
     bk account login <nombre>        volver a hacer el login de una cuenta
     bk account use <nombre> [--relaunch]   usarla en esta sesión: lo que lances desde acá
                                       (agentes, chats) corre con ella. --relaunch: el chat principal
                                       también, retomando la misma conversación
     bk account use default [claude|codex]   volver a la de siempre
     bk run|fix|review|plan|orchestrate … --account <nombre>   solo para ese lanzamiento
EOF
      ;;
    *) die "bk account [new|login|use] (bk account help)" ;;
  esac
}

account_login() {
  local name="$1" prov kv; prov=$(python3 "$ACCOUNTS" provider "$name")
  [ -n "$prov" ] || die "no existe la cuenta $name (bk account)"
  kv=$(python3 "$ACCOUNTS" env "$name")
  case "$prov" in
    claude) env "$kv" claude auth login ;;
    codex)  command -v codex >/dev/null || die "Codex CLI no está instalado"
            env "$kv" codex login ;;
  esac
}

account_use() {
  local name="" relaunch=0 only=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --relaunch) relaunch=1 ;;
      claude|codex) only="$1" ;;
      *) name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "bk account use <nombre> [--relaunch]"
  local s; s=$(caller_session)
  [ -n "$s" ] || die "bk account use va dentro de una sesión de bk (tmux)"
  local provs=() p kv
  if [ "$name" = default ]; then
    if [ -n "$only" ]; then provs=("$only"); else provs=(claude codex); fi
  else
    p=$(python3 "$ACCOUNTS" provider "$name"); [ -n "$p" ] || die "no existe la cuenta $name (bk account)"
    provs=("$p")
  fi
  [ "$DRY" -eq 1 ] && { info "(dry-run: $s usaría la cuenta $name)"; return 0; }
  for p in "${provs[@]}"; do
    if [ "$name" = default ]; then
      [ "$p" = claude ] && kv=CLAUDE_CONFIG_DIR || kv=CODEX_HOME
      tmux set-option -u -t "$s" "@bk_account_$p" 2>/dev/null || true
      tmux set-environment -u -t "$s" "BK_ACCOUNT_$(upper "$p")" 2>/dev/null || true
      tmux set-environment -u -t "$s" "$kv" 2>/dev/null || true
    else
      tmux set-option -t "$s" "@bk_account_$p" "$name"
      # También para los panes nuevos de la sesión (un split donde corrés claude a mano)
      kv=$(python3 "$ACCOUNTS" env "$name")
      tmux set-environment -t "$s" "${kv%%=*}" "${kv#*=}"
      tmux set-environment -t "$s" "BK_ACCOUNT_$(upper "$p")" "$name"
    fi
  done
  info "$s usa la cuenta $name: los agentes y chats que lances desde acá corren con ella"
  if [ "$relaunch" = 1 ]; then
    [[ " ${provs[*]} " == *" claude "* ]] && relaunch_chat "$s"
  else
    info "el chat principal sigue con la anterior hasta relanzarlo (bk account use $name --relaunch)"
  fi
}

# relaunch_chat <sesión>: el chat principal vuelve a arrancar con la cuenta de la sesión, retomando su
# conversación. No si está trabajando o esperando una respuesta tuya.
relaunch_chat() {
  local s="$1" pane f sid="" st="" dir top
  pane=$(tmux list-panes -t "$s:main" -F '#{pane_id} #{pane_title}' 2>/dev/null | awk '/✿ chat/ {print $1; exit}')
  [ -n "$pane" ] || die "no encontré el chat principal de $s"
  # El registro más nuevo de ese pane (el hook de estado lo nombra con el id de la sesión de Claude)
  while IFS= read -r f; do
    grep -q "\"pane\": *\"$pane\"" "$f" 2>/dev/null || continue
    sid=$(basename "$f" .json)
    st=$(sed -nE 's/.*"state": *"([a-z]+)".*/\1/p' "$f" | head -1)
    break
  done < <(ls -t "$STATE_DIR"/*.json 2>/dev/null)
  case "$st" in working|waiting|background) die "el chat está trabajando o te espera: relanzalo cuando termine" ;; esac
  case "$sid" in bk-*) sid="" ;; esac
  dir=$(tmux display-message -p -t "$pane" '#{pane_current_path}')
  top=$(tmux show-environment -t "$s" BK_PROJECT 2>/dev/null | sed -n 's/^BK_PROJECT=//p' || true)
  local CTA; BK_ACCOUNT="" BK_ACCOUNT_CLAUDE="" BK_FROM="$s" account_args claude
  tmux respawn-pane -k -t "$pane" -c "$dir" -e "BK_PROJECT=${top:-$dir}" "${CTA[@]+"${CTA[@]}"}" \
    "claude${sid:+ --resume $sid}; exec \$SHELL"
  info "chat relanzado${sid:+ (retoma $sid)}"
}

# ---------- tmux ----------
need_tmux() { command -v tmux >/dev/null || die "falta tmux (brew install tmux)"; }

has_window() { tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$1"; }

# Terminal rápida (alt+x): una sesión term-<proyecto> que sobrevive al popup. Se abre en la raíz del
# proyecto del pane; alt+x de nuevo la esconde y vuelve a aparecer como la dejaste.
# El popup no expande #{pane_current_path} en su comando: el directorio llega con -d (el $PWD de acá).
ws_term() {
  need_tmux
  local dir="$1" top name
  [ -d "$dir" ] || die "no existe la carpeta $dir"
  # El repo principal también desde un worktree de agente (su .git común está en el repo).
  # || true: en una carpeta sin git, con pipefail, el fallo de git cortaría el script.
  top=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  case "$top" in
    */.git) top=${top%/.git} ;;
    *) top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true); top=${top:-$dir} ;;
  esac
  name="term-$(basename "$top" | tr -c 'A-Za-z0-9_\n-' '_')"
  # Una sesión por repo, pero arranca en la carpeta desde donde la abriste (p. ej. el worktree)
  tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$dir"
  tmux set-option -t "=$name" status off >/dev/null 2>&1 || true
  exec env -u TMUX tmux attach -t "=$name"
}

# launch <ventana> <dir> <rol> <ref> <comando> [tarea] [orquestado: 1 si lo lanzó un orquestador]
# Con tarea (ADR-005): la crea (o arranca la pendiente), le pasa BK_TASK_DIR al agente y, si el proceso
# del agente termina sin `bk done`, la cierra como incomplete.
launch() {
  local win="$1" dir="$2" role="$3" ref="$4" cmd="$5" tid="${6:-}" orch="${7:-0}" spec provider model
  spec=$(role_spec "$role" "$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)")
  provider=${spec%%/*}; model=${spec#*/}
  local full; full=$(agent_cmd "$provider" "$model" "$cmd")
  local cta CTA; cta=$(account_of "$provider"); account_args "$provider"

  printf '%-8s %s · %s/%s\n  dir: %s\n  cmd: %s\n' "$win" "$role" "$provider" "$model" "$dir" "$full"
  [ -n "$tid" ] && printf '  tarea: %s\n' "$tid"
  [ -n "$cta" ] && printf '  cuenta: %s\n' "$cta"
  [ "$DRY" -eq 1 ] && { info "(dry-run: no se lanzó nada)"; return 0; }

  need_tmux
  if has_window "$win"; then
    # Misma ventana en otro proyecto (#12 de abra y #12 del kit): prefijar con el proyecto
    local other mine
    other=$(project_of "$(tmux display-message -p -t "$SESSION:$win" '#{pane_current_path}')")
    mine=$(project_of "$dir")
    if [ "$other" != "$mine" ]; then win="${mine:0:8}-$win"; fi
    has_window "$win" && die "ya existe la ventana '$win' (bk go $win, o bk stop $win)"
  fi
  local env=(-e "BARRILETE_ROLE=$role" -e "BARRILETE_MODEL=$model" -e "BARRILETE_PROVIDER=$provider")
  [ -n "$ref" ] && env+=(-e "BARRILETE_ISSUE=$ref")
  env+=("${CTA[@]+"${CTA[@]}"}")
  if [ -n "$tid" ]; then
    local proj tdir rc=0 extra=(); proj=$(project_of "$dir")
    [ "$orch" = 1 ] && extra=(--orchestrated)
    tdir=$(python3 "$TASKS" create "$proj" "$tid" --role "$role" --ref "$ref" --repo "$(project_top "$dir")" \
           --worktree "$dir" --window "$win" "${extra[@]+"${extra[@]}"}") || rc=$?
    case $rc in
      0) ;;
      3) # ya existe: solo se lanza si es una propuesta pendiente (lanzarla es aprobarla, D6)
         [ "$(python3 "$TASKS" state "$proj" "$tid")" = pending ] || die "ya hay una tarea activa $tid (bk tasks)"
         python3 "$TASKS" start "$tdir" --window "$win" ;;
      *) die "no pude crear la tarea $tid" ;;
    esac
    env+=(-e "BK_TASK_DIR=$tdir")
    full="$full; $(sq "$WS/bin/bk") _ended $(sq "$tdir")"
  fi
  local pane
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    pane=$(tmux new-window -d -P -F '#{pane_id}' -t "$SESSION:" -n "$win" -c "$dir" "${env[@]}" "$full")
  else
    pane=$(tmux new-session -d -P -F '#{pane_id}' -s "$SESSION" -n "$win" -c "$dir" "${env[@]}" "$full")
    # new-session -e también graba las variables en la sesión, y las heredarían todas las ventanas
    # siguientes (otro agente quedaba con el rol o el issue de este). Son solo de este pane.
    local kv
    for kv in "${env[@]}"; do [ "$kv" = -e ] || tmux set-environment -u -t "$SESSION" "${kv%%=*}" 2>/dev/null || true; done
  fi
  # La ventana queda abierta si el agente termina, para leer lo último
  tmux set-option -w -t "$SESSION:$win" remain-on-exit on >/dev/null
  pre_register "$win" "$pane" "$dir" "$role" "$model" "$ref"
  # El título del issue/PR para bk ls y la tira (una consulta a GitHub, en segundo plano)
  (python3 "$WS/lib/agents.py" warm >/dev/null 2>&1 &)
  info "lanzado → bk go $win"
}

# Registra al agente en la barra apenas se lanza. Claude Code no corre hooks hasta que aceptás
# el diálogo de confianza de la carpeta (cada worktree es nueva), así que sin esto el agente
# sería invisible justo cuando te necesita. El hook real (SessionStart) borra este registro.
pre_register() {
  local win="$1" pane="$2" dir="$3" role="$4" model="$5" ref="$6"
  mkdir -p "$STATE_DIR"
  jq -n --arg cwd "$dir" --arg role "$role" --arg model "$model" --arg ref "$ref" --arg pane "$pane" '
    {state: "waiting", tool: "confianza", cwd: $cwd, role: $role, model: $model, pane: $pane,
     subagents: 0, ts: (now | floor)} + (if $ref != "" then {ref: $ref} else {} end)' \
    > "$STATE_DIR/bk-$win.json"
  sketchybar --trigger agent_update >/dev/null 2>&1 || true
}

# task_guard <dir> <tarea>: si ya hay una tarea activa con ese id (ADR-005 D2), la muestra y sale sin lanzar
# otro agente. Una pendiente (un reviewer propuesto) sí se lanza: lanzarla es aprobarla.
task_guard() {
  local proj st; proj=$(project_of "$1")
  st=$(python3 "$TASKS" state "$proj" "$2") || return 0
  case "$st" in
    in_progress|waiting)
      local w; w=$(jq -r '.window // "-"' "$(python3 "$TASKS" root)/$proj/$2/task.json")
      info "ya hay una tarea activa: $2 ($st) → bk go $w   (bk tasks para ver todas)"; exit 0 ;;
  esac
}

# Estado de la sesión de Claude de un pane según el hook (working, done, waiting…), o nada. El más
# reciente: el pre-registro de launch (bk-<ventana>.json) comparte el pane hasta que arranca la sesión.
pane_state() {
  local f
  for f in "$STATE_DIR"/*.json; do
    [ -f "$f" ] && jq -c --arg p "$1" 'select(.pane == $p) | {ts: (.ts // 0), state}' "$f" 2>/dev/null
  done | jq -rs 'sort_by(.ts) | last | .state // empty' 2>/dev/null
}

# Escribir en el pane lo que bk say encoló mientras el agente trabajaba (lo llama el hook al terminar el turno)
task_drain() {
  local td="$1" tp="$2" line msg
  # Con un menú abierto, lo encolado espera: el Enter elegiría una opción
  [ -z "$(open_menu "$tp")" ] || return 0
  python3 "$TASKS" drain "$td" | while IFS= read -r line; do
    msg=$(jq -r '.msg // empty' <<<"$line"); [ -n "$msg" ] || continue
    tmux send-keys -t "$tp" -l -- "$msg"; sleep 0.2; tmux send-keys -t "$tp" Enter; sleep 0.5
  done
}

# Propuestas que esperan tu aprobación (ADR-005 D6), para el final de bk ls
task_proposals() {
  python3 "$TASKS" list --json 2>/dev/null \
    | jq -r '.[] | select(.status == "pending") | "◆ propuesta: \(.id) (\(.project)) → bk approve \(.id)"' 2>/dev/null || true
}

cmd_approve() {
  local id="${1:?bk approve <tarea>   (bk tasks muestra las pendientes)}" t repo
  t=$(python3 "$TASKS" list --json | jq -c --arg id "$id" '[.[] | select(.id == $id and .status == "pending")] | first // empty')
  [ -n "$t" ] || die "no hay una tarea pendiente '$id' (bk tasks)"
  repo=$(jq -r '.repo // empty' <<<"$t")
  [ -d "$repo" ] || die "no sé en qué repo lanzar $id"
  case "$(jq -r .role <<<"$t")" in
    reviewer) local pr; pr=$(jq -r '.pr // empty' <<<"$t"); cd "$repo" && cmd_review "$pr" ;;
    *) die "bk approve lanza reviewers propuestos; $id es de otro rol" ;;
  esac
}

# resolve_win <algo>: la ventana de un agente por su nombre, un número (#240 es el PR de i218) o una
# palabra del título. Si no alcanza, en una terminal abre el selector; si no, lista los candidatos y falla.
# Pane de lo que devolvió resolve_win: un agente (su ventana) o un chat (chat:<workspace>)
win_pane() {
  case "$1" in
    chat:*) # el pane del chat del workspace: el de la ventana main que no es la tira ni el riel
            tmux list-panes -t "${1#chat:}:main" -F '#{pane_id} #{pane_start_command}' 2>/dev/null \
              | grep -v -e 'bk rail' -e 'bk sidebar' | head -1 | cut -d' ' -f1 ;;
    *)      agent_target "$1" ;;
  esac
}

resolve_win() {
  if has_window "$1"; then printf '%s' "$1"; return; fi
  python3 "$WS/lib/agents.py" resolve "$1"
}

go() {
  need_tmux
  local win="${1:-}"
  tmux has-session -t "$SESSION" 2>/dev/null || die "no hay agentes (sesión tmux '$SESSION' vacía)"
  if [ -n "$win" ]; then win=$(resolve_win "$win") || exit 1; fi
  local target="$SESSION${win:+:$win}"
  case "$win" in chat:*) target="${win#chat:}" ;; esac   # un chat: su workspace
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$target"; else exec tmux attach -t "$target"; fi
}

# Pane real del agente de la ventana <win>: si alt+shift+N lo llevó al lugar del chat de un workspace,
# en su ventana quedó el chat de visita (@bk_ws) y el agente está en <workspace>:main (@bk_guest).
agent_target() {
  local win="$1" p ws
  read -r p ws < <(tmux list-panes -t "$SESSION:$win" -F '#{pane_id} #{@bk_ws}' 2>/dev/null | head -1)
  if [ -n "$ws" ]; then tmux show-options -wqv -t "$ws:main" @bk_guest; else echo "${p:-$SESSION:$win}"; fi
}

# Ver la pantalla de un agente sin entrar. Sin ventana: un resumen de todas.
peek() {
  need_tmux
  tmux has-session -t "$SESSION" 2>/dev/null || die "no hay agentes (sesión tmux '$SESSION' vacía)"
  local win="${1:-}" n="${2:-}"
  if [ -n "$win" ]; then
    win=$(resolve_win "$win") || exit 1
    tmux capture-pane -p -J -t "$(win_pane "$win")" -S "-${n:-60}"
    return
  fi
  local w
  for w in $(tmux list-windows -t "$SESSION" -F '#{window_name}'); do
    printf '\033[1;35m── %s\033[0m\n' "$w"
    # Sin líneas vacías ni el marco del prompt de Claude Code, para que entre en pantalla
    tmux capture-pane -p -J -t "$(agent_target "$w")" -S -80 | grep -v '^[[:space:]]*$' | grep -v '^[─╭╰│ ]*$' | tail -n "${n:-8}"
    echo
  done
}

# Escribir en la ventana de un agente: es tu teclado, así que vale como tu respuesta
# (planes, "publicá", confianza…). Pensado para que lo corras vos; un agente no debería
# usarlo para aprobar en tu nombre.
# Sin ventana (un solo argumento): al agente que te está esperando; si son varios, un selector.
# La ventana puede ser el nombre (i218), un número (240, #218) o una palabra del título (glosario).
# open_menu <pane>: si el agente muestra un menú de Claude Code (pregunta con opciones o pedido de permiso),
# imprime sus opciones; si no, nada. Se reconoce por el pie del menú ("Enter to select", "Esc to cancel").
open_menu() {
  local scr; scr=$(tmux capture-pane -p -J -t "$1" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 25)
  grep -qE 'Enter to (select|confirm)|Esc to (cancel|exit)|↑/↓ to navigate' <<<"$scr" || return 0
  grep -E '^[[:space:]]*(❯[[:space:]]*)?[0-9]+\.[[:space:]]' <<<"$scr" | sed -E 's/^[[:space:]]*//' | head -n 9
}

say() {
  need_tmux
  local now=0; [ "${1:-}" = "--now" ] && { now=1; shift; }
  [ $# -gt 0 ] || die 'bk say [--now] ["agente"] "mensaje"   (agente: nombre, número o palabra; sin él, el que te espera)'
  tmux has-session -t "$SESSION" 2>/dev/null || die "no hay agentes (sesión tmux '$SESSION' vacía)"
  local win msg
  if [ $# -eq 1 ]; then
    msg="$1"; win=$(python3 "$WS/lib/agents.py" auto) || exit 1
  else
    win=$(resolve_win "$1") || exit 1; shift; msg="$*"
  fi
  [ -n "$msg" ] || die "falta el mensaje"
  local tp; tp=$(win_pane "$win")
  # Trabajando (ADR-005 D8): se encola y el hook lo escribe cuando el agente termina el turno
  case "$win" in chat:*) ;; *)
    local td; td=$(python3 "$TASKS" find --window "$win" 2>/dev/null || true)
    if [ -n "$td" ] && [ "$now" -eq 0 ] && [ "$(pane_state "$tp")" = working ]; then
      python3 "$TASKS" queue "$td" "$msg"
      info "→ $win está trabajando: encolado, se lo escribo al terminar su turno (bk say --now para ya)"
      return
    fi ;;
  esac
  # Un menú abierto (pregunta con opciones, permiso): el Enter elegiría la opción marcada aunque el texto sea
  # otra cosa. El 2026-11-04 una aclaración aprobó así una ruta sensible. Con un menú, solo pasa un número.
  local menu; menu=$(open_menu "$tp")
  if [ -n "$menu" ] && ! [[ "$msg" =~ ^[0-9]$ ]]; then
    printf 'bk: %s tiene un menú abierto; tu texto no se mandó (el Enter elegiría la opción marcada).\n' "${win#chat:}" >&2
    printf '%s\n' "$menu" | sed 's/^/    /' >&2
    printf '    Respondé con el número: bk say %s <n>\n' "${win#chat:}" >&2
    exit 1
  fi
  tmux send-keys -t "$tp" -l -- "$msg"
  sleep 0.2
  tmux send-keys -t "$tp" Enter
  info "→ ${win#chat:}: $msg   (bk peek ${win#chat:} para ver la respuesta)"
}

# Espejo en vivo de un agente (solo lectura). Sin ventana, cada `bk watch` "reclama" un agente
# que no esté mirando otro panel, y cuando ese agente se cierra pasa al siguiente.
WATCH_DIR="$HOME/.cache/barrilete/watch"
watch_claimed() {  # ¿hay otro bk watch vivo mirando esta ventana?
  local f="$WATCH_DIR/$1" pid
  [ -f "$f" ] || return 1
  pid=$(cat "$f" 2>/dev/null)
  [ -n "$pid" ] && [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null
}
watch_pick() {
  # Solo ventanas con un agente vivo: las que quedaron en una shell (agente terminado) no cuentan
  local w dead cmd
  while read -r w dead cmd; do
    [ "$dead" = 1 ] && continue   # remain-on-exit: el agente salió y quedó el pane muerto
    case "$cmd" in zsh|bash|sh|fish|-zsh|login) continue ;; esac
    watch_claimed "$w" || { echo "$w"; return; }
  done < <(tmux list-windows -t "$SESSION" -F '#{window_name} #{pane_dead} #{pane_current_command}' 2>/dev/null)
}
watch() {
  need_tmux
  # Columna del workspace: todos los agentes en un panel que se reparte solo
  [ "${1:-}" = "--all" ] && exec python3 "$WS/lib/agents_view.py"
  # Bucle infinito: que un grep vacío o una ventana que desaparece no lo corten
  set +euo pipefail
  local fixed="${1:-}" pane hdr lines cols state
  win=""   # global: el trap de salida la necesita para liberar el reclamo
  mkdir -p "$WATCH_DIR"
  trap 'printf "\033[?25h"; [ -n "$win" ] && [ "$(cat "$WATCH_DIR/$win" 2>/dev/null)" = "$$" ] && rm -f "$WATCH_DIR/$win"; exit 0' INT TERM EXIT
  printf '\033[?25l\033[2J'
  while :; do
    # Elegir / validar la ventana
    if [ -n "$win" ] && ! has_window "$win"; then
      rm -f "$WATCH_DIR/$win"; win=""
    fi
    # En modo automático, si el agente terminó (quedó una shell), pasar al siguiente
    if [ -n "$win" ] && [ -z "$fixed" ]; then
      case "$(tmux display-message -p -t "$SESSION:$win" '#{?pane_dead,dead,#{pane_current_command}}' 2>/dev/null)" in
        dead|zsh|bash|sh|fish|-zsh|login) rm -f "$WATCH_DIR/$win"; win="" ;;
      esac
    fi
    if [ -z "$win" ]; then
      if [ -n "$fixed" ]; then has_window "$fixed" && win="$fixed"; else win=$(watch_pick); fi
      [ -n "$win" ] && [ -z "$fixed" ] && echo $$ > "$WATCH_DIR/$win"
    fi
    lines=$(tput lines); cols=$(tput cols)
    if [ -z "$win" ]; then
      printf '\033[H\033[2J\033[2m  %s\033[0m' "${fixed:+esperando $fixed…}"
      [ -z "$fixed" ] && printf '\033[2m  sin agentes libres para mirar (bk run / bk review)\033[0m'
      sleep 2; continue
    fi
    # Encabezado: ventana · rol · modelo · estado (del estado de la barra)
    pane=$(tmux list-panes -t "$SESSION:$win" -F '#{pane_id}' 2>/dev/null | head -1)
    state=$(grep -l "\"pane\": *\"$pane\"" "$STATE_DIR"/*.json 2>/dev/null | head -1)
    hdr="$win"
    [ -n "$state" ] && hdr+=$(jq -r '"  ·  \(.role // "-")  ·  \(.model // "-")  ·  \(.state // "-")\(if .tool then " (\(.tool))" else "" end)"' "$state" 2>/dev/null)
    [ -n "${BK_WATCH_KEYS:-}" ] && hdr+="     q volver · enter escribirle · x cerrar el agente"
    {
      printf '\033[H\033[1;35m%s\033[0m\033[K\n' "${hdr:0:$cols}"
      # Sin el pie de Claude Code (caja del prompt + "auto mode"): en un panel chico se comía todo
      tmux capture-pane -p -e -t "$(agent_target "$win")" 2>/dev/null \
        | grep -v '^[[:space:]]*$' \
        | awk '{ l[NR] = $0; t = $0; gsub(/\033\[[0-9;?]*[A-Za-z]/, "", t)
                 if (t ~ /^─────/) { s2 = s1; s1 = NR } }
               END { n = (s2 ? s2 - 1 : NR); for (i = 1; i <= n; i++) print l[i] }' \
        | tail -n $((lines - 2)) \
        | while IFS= read -r l; do printf '%s\033[0m\033[K\n' "$l"; done
      printf '\033[J'
    }
    # Con BK_WATCH_KEYS (popup de la tira): q/esc cierra, enter va a la ventana del agente para escribirle
    if [ -n "${BK_WATCH_KEYS:-}" ]; then
      local k=""
      if IFS= read -rsn1 -t 1 k; then
        case "$k" in
          q|$'\e') exit 0 ;;
          x) [ -n "$win" ] && "$0" stop "$win" >/dev/null 2>&1; exit 0 ;;   # cerrar ese agente
          "") # enter: ir a la ventana del agente (alt+q o alt+0 vuelven al workspace)
              [ -n "$win" ] && tmux switch-client ${BK_WATCH_CLIENT:+-c "$BK_WATCH_CLIENT"} -t "$SESSION:$win"
              exit 0 ;;
        esac
      fi
    else
      sleep 1
    fi
  done
}

# ---------- workspace (bk sin argumentos) ----------
# Layout (sesión tmux "bk"), a lo gentle-shell:
#   ┌───────────────────────────────┬──────────────────┐
#   │                               │ ✿ Status         │
#   │  chat con el orquestador      │ ∗ Agents         │
#   │  (claude)                     │ ✎ Changes        │
#   │                               │ ✎ Changes        │
#   │                               │ ♫ radio · atajos │
#   └───────────────────────────────┴──────────────────┘
#    ✿ bk · repo rama · agentes · tokens/costo de hoy        (barra de tmux = footer)
# Overlays (popups): alt+a agentes · alt+g cambios · alt+k comandos · alt+s sesiones
# Un workspace por proyecto: sesión tmux "bk-<proyecto>", cada una en su ventana de Ghostty
# (y su escritorio de macOS). Los agentes siguen en la sesión "agents"; el riel y el footer
# muestran solo los del proyecto (BK_PROJECT en el entorno de la sesión).
project_top() {  # raíz del proyecto: el repo, o el repo principal si es un worktree de prepare.sh
  local top; top=$(git -C "${1:-$PWD}" rev-parse --show-toplevel 2>/dev/null) || { (cd "${1:-$PWD}" && pwd); return; }
  case "$(basename "$(dirname "$top")")" in
    *-wt) local main; main="$(dirname "$(dirname "$top")")/$(basename "$(dirname "$top")" | sed 's/-wt$//')"
          [ -d "$main" ] && { echo "$main"; return; } ;;
  esac
  echo "$top"
}
project_of() { basename "$(project_top "$1")" | tr '.:' '__'; }
WS_SESSION="${BK_WS_SESSION:-}"

workspace() {
  need_tmux
  local dir; dir=$(cd "${1:-$PWD}" && pwd) || die "no existe $1"
  local top; top=$(project_top "$dir")
  WS_SESSION="${WS_SESSION:-bk-$(project_of "$dir")}"
  if ! tmux has-session -t "$WS_SESSION" 2>/dev/null; then
    local cols lines chat rail
    cols=$(tput cols 2>/dev/null || echo 200); lines=$(tput lines 2>/dev/null || echo 50)
    # El chat sobrevive a un /exit: vuelve a una shell en la misma carpeta
    # La cuenta de donde se abre (bk account use, o BK_ACCOUNT=x bk) pasa a la sesión nueva; new-session -e
    # también la deja en el entorno de la sesión, como bk account use
    local CTA cx; account_args claude; cx=$(account_of codex)
    chat=$(tmux new-session -d -P -F '#{pane_id}' -s "$WS_SESSION" -n main -c "$dir" -x "$cols" -y "$lines" \
           -e "BK_PROJECT=$top" "${CTA[@]+"${CTA[@]}"}" "claude; exec \$SHELL")
    [ ${#CTA[@]} -eq 0 ] || tmux set-option -t "$WS_SESSION" @bk_account_claude "$(account_of claude)"
    [ -z "$cx" ] || { BK_FROM="$WS_SESSION" account_use "$cx" >/dev/null; }
    tmux set-environment -t "$WS_SESSION" BK_PROJECT "$top"
    [ -z "${BK_WS_NAME:-}" ] || tmux set-option -t "$WS_SESSION" @bk_name "$BK_WS_NAME"
    rail=$(tmux split-window -d -P -F '#{pane_id}' -h -l 34% -t "$chat" -c "$dir" -e "BK_PROJECT=$top" "bk rail")
    # Tira izquierda: sesiones activas (workspaces y agentes), a lo Gentle Shell 4
    local side
    side=$(tmux split-window -d -P -F '#{pane_id}' -hb -l 5 -t "$chat" -c "$dir" "bk sidebar")
    local p
    for p in "$chat" "$rail" "$side"; do tmux set-option -p -t "$p" allow-set-title off >/dev/null 2>&1; done
    tmux select-pane -t "$chat" -T "✿ chat"
    tmux select-pane -t "$rail" -T "rail"
    ws_style
    tmux select-pane -t "$chat"
    # La sesión nace con el tamaño de la terminal que la crea: reacomodar al conectarse/redimensionar
    tmux set-hook -t "$WS_SESSION" client-attached "run-shell -b 'bk _layout #{session_name}'"
    tmux set-hook -t "$WS_SESSION" client-resized "run-shell -b 'bk _layout #{session_name}'"
  fi
  if [ -n "${TMUX:-}" ]; then tmux switch-client ${BK_CLIENT:+-c "$BK_CLIENT"} -t "$WS_SESSION"; else exec tmux attach -t "$WS_SESSION"; fi
}

# bk open <proyecto|ruta>: ventana nueva de Ghostty con el workspace de ese proyecto, en el
# escritorio donde estás. Sin argumento: lista los workspaces abiertos.
resolve_project() {
  local q="$1" d
  [ -d "$q" ] && { (cd "$q" && pwd); return; }
  for d in "$HOME/$q" "$HOME"/*/"$q"; do [ -d "$d" ] && { echo "$d"; return; }; done
  d=$(find "$HOME" -maxdepth 3 -type d -name "$q" -not -path '*/Library/*' -not -path '*/node_modules/*' \
        -not -path '*/.*' 2>/dev/null | head -1)
  [ -n "$d" ] && echo "$d"
}
# bk rerun [--go] [pr…]: vuelve a correr los checks de GitHub Actions que fallaron en los PRs
# abiertos del repo actual (o en los PRs dados). Sin --go solo muestra qué correría.
cmd_rerun() {
  local go=0 prs=() n url run
  while [ $# -gt 0 ]; do
    case "$1" in --go) go=1 ;; *) prs+=("${1#\#}") ;; esac; shift
  done
  [ ${#prs[@]} -gt 0 ] || read -r -a prs < <(gh pr list --state open --json number -q '[.[].number] | join(" ")')
  [ ${#prs[@]} -gt 0 ] || die "no hay PRs abiertos en este repo"
  local runs=() seen=" "
  for n in "${prs[@]}"; do
    while IFS=$'\t' read -r name state url; do
      [ "$state" = fail ] || continue
      run=$(sed -nE 's#.*/actions/runs/([0-9]+)/job/.*#\1#p' <<<"$url")
      [ -n "$run" ] || { info "#$n $name: no es de GitHub Actions ($url), lo salteo"; continue; }
      printf '  #%-5s %-24s run %s\n' "$n" "$name" "$run"
      case "$seen" in *" $run "*) ;; *) seen+="$run "; runs+=("$run") ;; esac
    done < <(gh pr checks "$n" 2>/dev/null | awk -F'\t' '{print $1"\t"$2"\t"$4}')
  done
  [ ${#runs[@]} -gt 0 ] || { info "ningún check fallido para volver a correr"; return; }
  if [ "$go" -eq 0 ]; then
    echo; info "${#runs[@]} corridas para volver a correr. Para hacerlo: bk rerun --go ${prs[*]}"
    return
  fi
  for run in "${runs[@]}"; do
    if gh run rerun "$run" --failed >/dev/null 2>&1; then echo "  ↻ $run"; else echo "  ✗ $run (gh run rerun falló)"; fi
  done
}

# bk _agent <sesión> <N|0>: muestra el agente N de la tira en el lugar del chat del workspace (swap-pane:
# la tira y el riel quedan). 0 devuelve el orquestador. El pane del chat se marca con @bk_ws para
# reconocerlo aunque esté de visita en la sesión agents.
ws_agent() {
  set +euo pipefail
  local s="${1:?}" n="${2:-0}" w guest chat target
  w="$s:main"
  case "$s" in bk*) ;; *) tmux display-message "alt+shift+N funciona dentro de un workspace (bk)"; return ;; esac
  guest=$(tmux show-options -wqv -t "$w" @bk_guest)
  chat=$(tmux show-options -wqv -t "$w" @bk_chat)
  if [ -n "$guest" ] && [ -n "$chat" ]; then           # primero devolver el que está de visita
    tmux swap-pane -d -s "$guest" -t "$chat" 2>/dev/null
    tmux set-option -wu -t "$w" @bk_guest; tmux set-option -wu -t "$w" @bk_chat
    tmux set-option -pu -t "$chat" @bk_ws 2>/dev/null
  fi
  [ "$n" = 0 ] && { tmux select-pane -t "${chat:-$w}" 2>/dev/null; return; }
  # El N-ésimo agente, en el mismo orden que la tira (ventanas de "agents", sin chats de workspaces)
  if [[ "$n" == %* ]]; then target="$n"; else
  target=$(tmux list-panes -s -t "$SESSION" -F '#{pane_id} #{@bk_ws}' 2>/dev/null | awk '$2 == "" {print $1}' | sed -n "${n}p")
  fi
  [ -n "$target" ] || { tmux display-message "no hay agente $n"; return; }
  chat=$(tmux list-panes -t "$w" -F '#{pane_id} #{pane_start_command}' | grep -v -e 'bk rail' -e 'bk sidebar' | head -1 | cut -d' ' -f1)
  [ -n "$chat" ] || return
  tmux set-option -p -t "$chat" @bk_ws "$s"
  tmux swap-pane -d -s "$target" -t "$chat"
  tmux set-option -w -t "$w" @bk_guest "$target"; tmux set-option -w -t "$w" @bk_chat "$chat"
  tmux select-pane -t "$target"
  tmux display-message "agente $n en el lugar del chat · alt+q vuelve al orquestador"
}

# Ventana nueva de terminal que corre <comando>: Ghostty si está, si no Terminal de macOS.
new_window() {
  if [ -d /Applications/Ghostty.app ]; then
    open -na Ghostty.app --args -e /bin/zsh -lc "$1"
  elif [ "$(uname)" = Darwin ]; then
    osascript -e "tell application \"Terminal\" to do script \"$1\"" -e 'tell application "Terminal" to activate' >/dev/null
  else
    die "abrí una terminal nueva y corré: $1"
  fi
}

# bk chat [--suelto | --rama <nombre>] [sesión]
#   (sin opción)  otro chat del proyecto del workspace: un workspace más en la tira (bk-<proyecto>-2, -3…),
#                 no reemplaza al actual
#   --rama N      un workspace en su propio worktree (../<repo>-wt/chat-<n>) y rama chat/<n>, creada desde
#                 la rama principal de origin: varios cambios del mismo proyecto a la vez sin pisarse.
#                 Si ya existe, lo reusa
#   --suelto      un claude sin proyecto (~/.bk/chats) en la sesión "agents", traído al lugar del chat
# bk name "<nombre>": cómo se llama el chat de este workspace (bk ls, la tira, bk say/go <nombre>).
# Sin nombre: lo muestra. bk name -: lo borra (vuelve al de /rename o al título de Claude).
cmd_name() {
  need_tmux
  local ws="${BK_FROM:-$(tmux display-message -p '#{session_name}' 2>/dev/null || true)}"
  case "$ws" in bk*) ;; *) die "bk name va desde el chat de un workspace (bk-…)" ;; esac
  if [ $# -eq 0 ]; then tmux show-options -qv -t "$ws" @bk_name; return; fi
  if [ "$1" = - ]; then tmux set-option -u -t "$ws" @bk_name; info "sin nombre: $ws"; return; fi
  tmux set-option -t "$ws" @bk_name "$*"
  info "$ws se llama «$*» (bk say/go $*)"
}

cmd_chat() {
  set +euo pipefail
  local loose=0 branch="" want_branch=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --suelto) loose=1; shift ;;
      --nombre) export BK_WS_NAME="${2:?--nombre necesita un nombre}"; shift 2 ;;
      --rama) want_branch=1; branch="${2:-}"; if [ $# -ge 2 ]; then shift 2; else shift; fi ;;
      *) break ;;
    esac
  done
  local s="${1:-$(tmux display-message -p '#{session_name}' 2>/dev/null)}" top name n pane
  if [ "$want_branch" = 1 ] && [ "$loose" = 0 ]; then
    # Todo se valida antes de crear nada (worktree, rama o sesión)
    [ -n "${branch//[[:space:]]/}" ] || die "bk chat --rama <nombre del cambio>"
    top=$(tmux show-environment -t "$s" BK_PROJECT 2>/dev/null | sed -n 's/^BK_PROJECT=//p')
    top="${top:-$PWD}"
    git -C "$top" rev-parse --show-toplevel >/dev/null 2>&1 || die "una rama aparte necesita un repo git ($top no es uno)"
    top=$(project_top "$top")   # el repo principal, aunque el chat actual ya esté en un worktree
    local slug wt base
    # Sin acentos (ñ → n): iconv puede salir con error aunque haya convertido todo, así que se usa lo que
    # devolvió y, solo si no devolvió nada, el nombre tal cual. Los ~ ' ^ que deja la transliteración, fuera.
    slug=$(printf '%s' "$branch" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null)
    [ -n "$slug" ] || slug=$branch
    slug=$(printf '%s' "$slug" | tr -d "~'^\`\"" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' \
           | cut -c1-30 | sed 's/^-*//; s/-*$//')
    [ -n "$slug" ] || die "el nombre '$branch' no deja un nombre de rama válido (usá letras o números)"
    wt="$(dirname "$top")/$(basename "$top")-wt/chat-$slug"
    if [ ! -d "$wt" ]; then
      git -C "$top" fetch -q origin 2>/dev/null
      base=$(git -C "$top" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo HEAD)
      if git -C "$top" show-ref -q --verify "refs/heads/chat/$slug"; then
        git -C "$top" worktree add -q "$wt" "chat/$slug" || die "no pude crear el worktree $wt"
      else
        git -C "$top" worktree add -q -b "chat/$slug" "$wt" "$base" || die "no pude crear el worktree $wt"
      fi
      info "rama chat/$slug desde $base · $wt"
    fi
    # Un workspace propio (otro número en la tira, alt+N): bk-<proyecto>-<nombre>; si ya está, vuelve a él
    WS_SESSION="bk-$(project_of "$top")-$slug"
    workspace "$wt"
    return
  elif [ "$want_branch" = 1 ]; then
    die "--rama y --suelto no van juntos"
  elif [ "$loose" = 0 ]; then
    # Otro chat en la carpeta del proyecto: un workspace más (bk-<proyecto>-2, -3…), no reemplaza al actual
    top=$(tmux show-environment -t "$s" BK_PROJECT 2>/dev/null | sed -n 's/^BK_PROJECT=//p')
    top="${top:-$PWD}"
    local wsbase k=2; wsbase="bk-$(project_of "$top")"
    while tmux has-session -t "=$wsbase-$k" 2>/dev/null; do k=$((k + 1)); done
    WS_SESSION="$wsbase-$k"
    workspace "$top"
    return
  fi
  # Chat sin proyecto: en una carpeta propia (~/.bk/chats), así Claude no lee tu home ni pide confiar en ella
  top="$HOME/.bk/chats"; mkdir -p "$top"; name="c-suelto"
  n=1; while has_window "$name$([ $n -gt 1 ] && echo "-$n")"; do n=$((n + 1)); done
  [ $n -gt 1 ] && name="$name-$n"
  local CTA kv; account_args claude
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    pane=$(tmux new-window -d -P -F '#{pane_id}' -t "$SESSION:" -n "$name" -c "$top" "${CTA[@]+"${CTA[@]}"}" "claude")
  else
    pane=$(tmux new-session -d -P -F '#{pane_id}' -s "$SESSION" -n "$name" -c "$top" "${CTA[@]+"${CTA[@]}"}" "claude")
    # Como en launch: que la cuenta de este chat no quede en el entorno de la sesión de agentes
    for kv in "${CTA[@]+"${CTA[@]}"}"; do [ "$kv" = -e ] || tmux set-environment -u -t "$SESSION" "${kv%%=*}" 2>/dev/null || true; done
  fi
  tmux set-option -w -t "$SESSION:$name" remain-on-exit on >/dev/null
  case "$s" in bk*) ws_agent "$s" "$pane" ;; *) info "chat nuevo: $name (bk go $name)" ;; esac
}


# bk _prs: PRs tuyos listos para mergear y reviews que te pidieron, para bk checkpoints (lib/checkpoints.py)
# (la escribe en ~/.cache/bk/checkpoints_prs.json; checkpoints.py la pide cada ~2 min en segundo plano)
cmd_prs() {
  set +euo pipefail
  command -v gh >/dev/null || return 0
  local CACHE="$HOME/.cache/bk/checkpoints_prs.json" lock="${TMPDIR:-/tmp}/bk_prs.lock"
  mkdir -p "$(dirname "$CACHE")"; mkdir "$lock" 2>/dev/null || return 0
  gh api graphql -f query='
    { mine: search(query: "is:pr is:open author:@me archived:false draft:false", type: ISSUE, first: 30) {
        nodes { ... on PullRequest {
          number title url reviewDecision updatedAt
          repository { nameWithOwner }
          reviews(last: 1) { totalCount nodes { body submittedAt } }
          commits(last: 1) { nodes { commit { committedDate statusCheckRollup { state } } } }
        } } }
      asked: search(query: "is:pr is:open review-requested:@me archived:false", type: ISSUE, first: 20) {
        nodes { ... on PullRequest { number title url updatedAt repository { nameWithOwner } } } } }' 2>/dev/null \
  | jq '[(.data.mine.nodes[]
          # /review-pr publica siempre como comentario, aunque tenga bloqueantes: hay que leer la última
          # review. Listo = CI verde, última review sin sección "Bloqueante/Blocking" y sin commits
          # posteriores a esa review (si hubo arreglos, el kit pide revisar de nuevo).
          | .reviews.nodes[0] as $r
          | .commits.nodes[0].commit as $c
          | select(.reviews.totalCount > 0
                   and .reviewDecision != "CHANGES_REQUESTED"
                   and ($c.statusCheckRollup.state // "SUCCESS") == "SUCCESS"
                   # La sección existe siempre: bloquea solo si no dice "Ninguno/None"
                   and (($r.body // "") | test("(^|\\n)#+\\s*(Bloqueantes?|Blocking|Blockers?)\\b[^\\n]*\\n\\s*(?!(Ningun[oa]|None|No hay|Sin bloqueantes)\\b)\\S"; "i") | not)
                   and (($c.committedDate // "") <= ($r.submittedAt // "")))
          | {kind: "merge", repo: .repository.nameWithOwner, number, title, url, updated: .updatedAt}),
         (.data.asked.nodes[] | {kind: "review", repo: .repository.nameWithOwner, number, title, url, updated: .updatedAt})]' \
    > "$CACHE.tmp" 2>/dev/null && [ -s "$CACHE.tmp" ] && mv "$CACHE.tmp" "$CACHE"
  rm -f "$CACHE.tmp"; rmdir "$lock" 2>/dev/null
}

cmd_open() {
  local q="${1:-}"
  if [ -z "$q" ]; then
    tmux list-sessions -F '#{session_name}	#{?session_attached,abierto,en segundo plano}	#{session_path}' 2>/dev/null \
      | awk -F'\t' '$1 ~ /^bk/ {printf "  %-24s %-18s %s\n", $1, $2, $3}'
    echo; info "bk open <proyecto|ruta> abre uno en una ventana nueva (en el escritorio actual)"
    return
  fi
  # Un workspace ya abierto con ese nombre (bk-<q>, o el único que lo contenga): conectarse a ese
  local sess
  # || true: sin coincidencias el grep falla y, con pipefail, cortaría el script sin decir nada
  sess=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -xF -- "bk-$q" \
         || tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^bk-' | grep -iF -- "$q" || true)
  if [ -n "$sess" ] && [ "$(wc -l <<<"$sess")" -eq 1 ]; then
    if [ -n "${TMUX:-}" ]; then tmux switch-client ${BK_CLIENT:+-c "$BK_CLIENT"} -t "$sess"; else
      new_window "tmux attach -t $sess"; fi
    info "→ $sess"; return
  fi
  local dir; dir=$(resolve_project "$q" || true); [ -n "$dir" ] || die "no encuentro el proyecto '$q' (pasá la ruta, o bk open para ver los abiertos)"
  new_window "cd '$dir' && bk ws"
  info "abriendo $(project_of "$dir") en una ventana nueva → $dir"
}

# Paleta gentle (rosa sobre oscuro): bordes finos, sin título en el riel, footer en la barra de tmux
ws_style() {
  local t="$WS_SESSION:main" s="$WS_SESSION" pal
  # Colores del tema (day/night) y posición del header, de lib/gentle.py y ~/.config/bk/ui.json
  pal=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import gentle as g; p = g.P
print(p["tint"], p["rose"], p["petal"], p["text"], p["muted"], p["frame"], p["iris"], g.ui()["header"])' "$WS/lib")
  read -r TINT ROSE PETAL TEXT MUTED FRAME IRIS HEAD <<<"$pal"
  tmux set-option -w -t "$t" pane-border-status off >/dev/null
  tmux set-option -w -t "$t" pane-border-lines single >/dev/null
  tmux set-option -w -t "$t" pane-border-style "fg=#$TINT" >/dev/null
  tmux set-option -w -t "$t" pane-active-border-style "fg=#$FRAME" >/dev/null
  tmux set-option -t "$s" popup-border-style "fg=#$ROSE" >/dev/null   # alt+a/g/k/s…: el rosa del tema (bk.conf trae el de noche)
  # Header a lo Gentle Shell 4: barra con fondo, proyecto · carpeta rama · modelo … uso
  tmux set-option -t "$s" status-position "${HEAD:-top}" >/dev/null
  tmux set-option -t "$s" status-style "bg=#$TINT,fg=#$MUTED" >/dev/null
  tmux set-option -t "$s" status-interval 10 >/dev/null
  tmux set-option -t "$s" status-left-length 100 >/dev/null
  tmux set-option -t "$s" status-right-length 120 >/dev/null
  tmux set-option -t "$s" window-status-format '' >/dev/null
  tmux set-option -t "$s" window-status-current-format '' >/dev/null
  tmux set-option -t "$s" status-left \
    "#[fg=#$ROSE,bold]  ✿ #{s/^bk-//:session_name} #[fg=#$MUTED,nobold]· #[fg=#$TEXT]#{s|$HOME|~|:pane_current_path} #[fg=#$PETAL,bold]#(git -C '#{pane_current_path}' branch --show-current 2>/dev/null)#[nobold] #[fg=#$MUTED]· #[fg=#$TEXT]#(bk _model #{session_name})" >/dev/null
  tmux set-option -t "$s" status-right "#[fg=#$IRIS]#(bk _footer #{session_name})  " >/dev/null
}

# Modelo del chat del workspace (el pane "main.0"), del estado que escribe el hook
ws_model() {
  set +euo pipefail
  local pane m
  pane=$(tmux list-panes -t "${1:-}:main" -F '#{pane_id} #{pane_start_command}' 2>/dev/null | awk '/claude/{print $1; exit}')
  m=$(grep -l "\"pane\": *\"$pane\"" "$STATE_DIR"/*.json 2>/dev/null | head -1 | xargs jq -r '.model // empty' 2>/dev/null)
  printf '%s' "${m:-claude}"
}

# Footer: agentes activos · tokens y costo de hoy (usa el caché incremental de usage.py)
ws_footer() {
  set +euo pipefail
  local act tot u top
  top=$(tmux show-environment -t "${1:-}" BK_PROJECT 2>/dev/null | sed -n 's/^BK_PROJECT=//p')
  local sel='true'
  [ -n "$top" ] && sel="((.cwd // \"\") as \$c | (\$c == \"$top\" or (\$c | startswith(\"$top/\")) or (\$c | startswith(\"$top-wt/\"))))"
  act=$(jq -s "[.[] | select($sel) | select(.state==\"working\" or .state==\"background\" or .state==\"waiting\")] | length" "$STATE_DIR"/*.json 2>/dev/null)
  tot=$(jq -s "[.[] | select($sel)] | length" "$STATE_DIR"/*.json 2>/dev/null)
  u=$(python3 "$WS/lib/usage.py" --json 2>/dev/null | jq -r '"\(.tokens/1000000*10|floor/10)M · $\(.cost_usd)"' 2>/dev/null)
  local word=activos; [ "${act:-0}" = 1 ] && word=activo
  printf '∗ %s %s#[default] · %s ≈API · usage alt+u' "${act:-0}" "$word" "${u:-—}"
}

# Proporciones: riel derecho 34 % (mínimo 46 columnas)
ws_layout() {
  set +euo pipefail
  local t="${1:-$WS_SESSION}:main" W rail w side
  W=$(tmux display-message -p -t "$t" '#{window_width}')
  [ -n "$W" ] || return 0
  rail=$(tmux list-panes -t "$t" -F '#{pane_id} #{pane_start_command}' | awk '/bk rail/{print $1; exit}')
  side=$(tmux list-panes -t "$t" -F '#{pane_id} #{pane_start_command}' | awk '/bk sidebar/{print $1; exit}')
  w=$((W * 34 / 100)); [ "$w" -lt 46 ] && w=46
  [ -n "$rail" ] && tmux resize-pane -t "$rail" -x "$w"
  [ -n "$side" ] && tmux resize-pane -t "$side" -x 5
  return 0
}

stop() {
  need_tmux
  local win="${1:?bk stop <ventana>}" panes
  win=$(resolve_win "$win") || exit 1
  case "$win" in chat:*) die "bk stop cierra agentes; un chat se cierra desde su workspace (/exit)" ;; esac
  # Si el agente está de visita en un workspace (alt+shift+N), en esta ventana quedó el chat de ese
  # workspace: devolverlo a su lugar antes de cerrar, para no matarlo. || true: sin chat de visita el
  # grep no encuentra nada y, con pipefail, cortaría el script en silencio.
  local ws
  ws=$(tmux list-panes -t "$SESSION:$win" -F '#{@bk_ws}' | grep -m1 . || true)
  [ -n "$ws" ] && ws_agent "$ws" 0
  panes=$(tmux list-panes -t "$SESSION:$win" -F '#{pane_id}')
  local td; td=$(python3 "$TASKS" find --window "$win" 2>/dev/null || true)
  [ -n "$td" ] && python3 "$TASKS" cancel "$td" >/dev/null
  tmux kill-window -t "$SESSION:$win"
  # Matar el pane no siempre dispara SessionEnd: limpiar el estado de la barra a mano
  for p in $panes; do
    { grep -l "\"pane\": *\"$p\"" "$STATE_DIR"/*.json 2>/dev/null || true; } | xargs rm -f
  done
  sketchybar --trigger agent_update >/dev/null 2>&1 || true
  info "cerrada $win (el worktree, si había, queda: cleanup.sh lo limpia cuando el issue cierre)"
}

# bk ls: los agentes de la sesión con el título de su issue/PR, los que te esperan primero.
# bk ls --all: la tabla de antes, con todas las sesiones de Claude que reporta el hook (chats incluidos).
ls_agents() {
  if [ "${1:-}" != "--all" ] && tmux has-session -t "$SESSION" 2>/dev/null; then
    python3 "$WS/lib/agents.py" list; task_proposals; return
  fi
  local files=("$STATE_DIR"/*.json)
  # Ventanas tmux por pane, para mostrar a qué ventana saltar
  local map='{}'
  if command -v tmux >/dev/null && tmux has-session -t "$SESSION" 2>/dev/null; then
    map=$(tmux list-panes -s -t "$SESSION" -F '#{pane_id} #{window_name}' \
          | jq -R 'split(" ") | {(.[0]): .[1]}' | jq -s 'add // {}')
  fi
  if [ ! -e "${files[0]}" ]; then echo "sin agentes"; task_proposals; return; fi
  jq -s -r --argjson map "$map" '
    def nz: if . == null or . == "" then "-" else tostring end;
    sort_by(-.ts) | .[]
    | [ ($map[.pane // ""] // "-"),
        (.cwd | split("/") as $p | if ($p[-2] // "" | endswith("-wt"))
           then "\($p[-2] | sub("-wt$"; ""))#\($p[-1])" else $p[-1] end),
        (.ref|nz), (.role|nz),
        ((.model // "") | sub("^claude-";"") | sub("-[0-9]{8}$";"") | nz),
        (if .phase == "plan_pending" and (.state == "done" or .state == "idle") then "plan esperando tu sí"
         else .state end),
        "\((now - .ts) / 60 | floor)m" ] | @tsv' "${files[@]}" \
  | { printf 'VENTANA\tPROYECTO\tREF\tROL\tMODELO\tESTADO\tHACE\n'; cat; } | column -t -s $'\t'
}

# role_mode <rol> [raíz] -> main | bk | sub: cómo lo lanza el orquestador (3.ª columna de roles.yml).
# Igual que role_spec: primero el roles.yml del proyecto y, si el rol no está ahí, el de bk. Sin modo: bk.
# bk sound [on|off|test|status]: un sonido por tipo de pedido de los agentes (lo toca el hook de estado)
cmd_sound() {
  local f="${BK_CONFIG_DIR:-$HOME/.config/bk}/sound" c
  case "$1" in
    on)     mkdir -p "$(dirname "$f")"; echo on >"$f"; info "sonidos prendidos" ;;
    off)    mkdir -p "$(dirname "$f")"; echo off >"$f"; info "sonidos apagados" ;;
    test)   for c in "working done" "working waiting question" "working waiting permission" "working error"; do
              # shellcheck disable=SC2086
              set -- $c; printf '  %s\n' "$(BK_SOUND_DRY=1 bash "$WS/lib/agent_sound.sh" "$@")"
              bash "$WS/lib/agent_sound.sh" "$@"; sleep 1.2
            done ;;
    status) if [ "$(cat "$f" 2>/dev/null)" = off ]; then echo apagados; else echo prendidos; fi ;;
    *) die "bk sound [on|off|test]" ;;
  esac
}

role_mode() {
  local role="$1" root="${2:-}" f mode="" found=0
  # El rol va dentro de una regex: solo nombres de rol, nada que sed o grep interpreten
  [[ "$role" =~ ^[A-Za-z0-9_-]+$ ]] || die "rol inválido: '$role'"
  for f in ${root:+"$root/.barrilete/roles.yml"} "$WS/roles.yml"; do
    [ -f "$f" ] || continue
    grep -qE "^[[:space:]]*${role}:" "$f" || continue
    found=1
    mode=$(sed -nE "s/^[[:space:]]*${role}:[[:space:]]*[^#[:space:]]+[[:space:]]+(main|bk|sub)([[:space:]#].*)?$/\1/p" "$f" | head -1)
    break
  done
  [ "$found" = 1 ] || die "el rol '$role' no está en roles.yml"
  printf '%s' "${mode:-bk}"
}

roles() {
  local root; root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  for r in planner orchestrator implementer implementer-light reviewer; do
    printf '%-18s %-16s %s\n' "$r" "$(role_spec "$r" "$root")" "$(role_mode "$r" "$root")"
  done
}


# ---------- comandos de agentes ----------
cmd_plan() {
  local idea="$*"; [ -n "$idea" ] || die 'bk plan "<idea>"'
  local root; root=$(project_root)
  launch plan "$root" planner "" "/plan-feature $idea"
}

cmd_review() {
  local pr="${1:?bk review <pr>}"; pr=${pr#\#}
  local root; root=$(project_root)
  task_guard "$root" "pr$pr-reviewer"
  launch "pr$pr" "$root" reviewer "#$pr" "/review-pr $pr" "pr$pr-reviewer"
}

cmd_orchestrate() {
  local root; root=$(project_root)
  launch orch "$root" orchestrator "" "/orchestrate"
}

# Retomar un PR abierto: mismo worktree/rama del implementer original (o uno nuevo si no existe).
cmd_fix() {
  local n="" role="implementer" msg="" orch=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --role) role="${2:?--role necesita un valor}"; shift 2 ;;
      --orchestrated) orch=1; shift ;;
      *) if [ -z "$n" ]; then n="${1#\#}"; else msg+="${msg:+ }$1"; fi; shift ;;
    esac
  done
  [[ "$n" =~ ^[0-9]+$ ]] && [ -n "$msg" ] || die "bk fix <pr> \"instrucción\""
  local root branch wt issue win
  root=$(project_root)
  task_guard "$root" "pr$n-implementer"; task_guard "$root" "pr$n-implementer-light"
  branch=$(cd "$root" && gh pr view "$n" --json headRefName,state -q 'select(.state=="OPEN") | .headRefName') \
    || die "no pude leer el PR #$n"
  [ -n "$branch" ] || die "el PR #$n no está abierto"
  # El worktree que ya tiene esa rama; si no hay, uno nuevo al lado de los de prepare.sh
  wt=$(git -C "$root" worktree list --porcelain | awk -v b="refs/heads/$branch" '/^worktree /{w=$2} $0=="branch "b{print w}')
  if [ -z "$wt" ]; then
    wt="$(dirname "$root")/$(basename "$root")-wt/pr$n"
    [ "$DRY" -eq 1 ] || { git -C "$root" fetch -q origin "$branch" && git -C "$root" worktree add -q "$wt" "$branch"; } \
      || die "no pude crear el worktree de $branch"
  fi
  issue=$(sed -nE 's#^claude/([0-9]+)-.*#\1#p' <<<"$branch")
  win="f$n"
  launch "$win" "$wt" "$role" "#${issue:-$n}" "Retomás el PR #$n (rama $branch, ya hecha por otro implementer). Seguí el flujo de /implement-issue ${issue:-} para correcciones de un PR existente (TDD, red.sh, verify, cuerpo del PR) y no abras otro PR. Tarea: $msg" "pr$n-$role" "$orch"
}

cmd_run() {
  local n="" role="" orch=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --role) role="${2:?--role necesita un valor}"; shift 2 ;;
      --orchestrated) orch=1; shift ;;
      *) n="${1#\#}"; shift ;;
    esac
  done
  [[ "$n" =~ ^[0-9]+$ ]] || die "bk run <issue>"
  local root; root=$(project_root)

  if [ -z "$role" ]; then
    local out
    out=$(cd "$root" && .claude/skills/orchestrate/routing.py "$n") || die "routing.py falló para #$n"
    case "$(sed -n 1p <<<"$out")" in
      haiku)  role=implementer-light ;;
      sonnet) role=implementer ;;
      *) die "routing.py devolvió algo inesperado: $out" ;;
    esac
    info "routing: $(sed -n 2p <<<"$out")"
  fi

  # Antes de prepare.sh: un segundo bk run sobre el mismo issue no lanza otro agente (ADR-005 D2), con
  # cualquiera de los dos implementers (comparten el worktree). Una escalada pasa: el liviano cerró con escalate.
  task_guard "$root" "$n-implementer"; task_guard "$root" "$n-implementer-light"

  if [ "$DRY" -eq 1 ]; then
    launch "i$n" "<worktree de prepare.sh>" "$role" "#$n" "/implement-issue $n" "$n-$role" "$orch"
    return
  fi

  # Mismo camino que /orchestrate: fetch una vez, prepare.sh valida, asigna y crea el worktree
  git -C "$root" fetch -q origin
  local prep wt
  prep=$(cd "$root" && .claude/skills/implement-issue/prepare.sh "$n" --worktree 2>&1) \
    || { printf '%s\n' "$prep" >&2; die "prepare.sh rechazó #$n (ver arriba)"; }
  wt=$(sed -nE 's/^Worktree: (.+)$/\1/p' <<<"$prep" | tail -1)
  [ -d "$wt" ] || { printf '%s\n' "$prep" >&2; die "prepare.sh no informó el worktree"; }
  launch "i$n" "$wt" "$role" "#$n" "/implement-issue $n" "$n-$role" "$orch"
}

# ---------- main ----------
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    # --account X: solo para este lanzamiento (bk-shell#16); lo leen launch y los chats
    --account) [ -n "${2:-}" ] || die "--account necesita un nombre (bk account)"
              [ "$2" = default ] || [ -n "$(python3 "$WS/lib/accounts.py" provider "$2")" ] \
                || die "no existe la cuenta $2 (bk account)"
              export BK_ACCOUNT="$2"; shift ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

case "${1:-}" in
  plan)        shift; cmd_plan "$@" ;;
  run)         shift; cmd_run "$@" ;;
  review)      shift; cmd_review "$@" ;;
  fix)         shift; cmd_fix "$@" ;;
  orchestrate) cmd_orchestrate ;;
  ls)          shift; ls_agents "${1:-}" ;;
  go)          shift; go "${1:-}" ;;
  peek)        shift; peek "${1:-}" "${2:-}" ;;
  say)         shift; say "$@" ;;
  watch)       shift; watch "${1:-}" ;;
  stop)        shift; stop "${1:-}" ;;
  done)        shift; rc=0; python3 "$TASKS" done "$@" || rc=$?
               sketchybar --trigger agent_update >/dev/null 2>&1 || true; exit $rc ;;
  tasks)       shift; case "${1:-}" in prune) shift; exec python3 "$TASKS" prune "$@" ;;
                                     *) exec python3 "$TASKS" list "$@" ;; esac ;;
  approve)     shift; cmd_approve "${1:-}" ;;
  checkpoints|ckpt) shift; exec python3 "$WS/lib/checkpoints.py" "$@" ;;
  _ended)      python3 "$TASKS" ended "${2:?}" || true; sketchybar --trigger agent_update >/dev/null 2>&1 || true ;;
  _drain)      task_drain "${2:?}" "${3:?}" ;;
  roles)       roles ;;
  account|accounts) shift; cmd_account "$@" ;;
  mode)        shift; [ -n "${1:-}" ] || die "bk mode <rol>"
               role_mode "$1" "$(git rev-parse --show-toplevel 2>/dev/null || true)"; echo ;;
  tokens)      exec python3 "$WS/lib/usage.py" ;;
  ""|ws)       shift || true; workspace "${1:-}" ;;
  open)        shift; cmd_open "${1:-}" ;;
  rerun)       shift; cmd_rerun "$@" ;;
  _prs)        cmd_prs ;;
  rail)        exec python3 "$WS/lib/rail.py" ;;
  sidebar)     exec python3 "$WS/lib/sidebar.py" ;;
  term|t)      shift; ws_term "${1:-$PWD}" ;;
  sub)         shift; exec python3 "$WS/lib/subwatch.py" "$@" ;;
  sound)       shift; cmd_sound "${1:-status}" ;;
  name)        shift; cmd_name "$@" ;;
  song)        shift; exec "$WS/lib/song.sh" "$@" ;;
  _nth)        tmux list-sessions -F '#{session_created} #{session_name}' 2>/dev/null \
                 | awk '$2 ~ /^bk/' | sort -n | awk -v n="${2:-1}" 'NR == n {print $2}' ;;
  changes)     exec python3 "$WS/lib/changes.py" ;;
  palette|k)   exec python3 "$WS/lib/palette.py" ;;
  _layout)     ws_layout "${2:-}" ;;
  _agent)      ws_agent "${2:-}" "${3:-0}" ;;
  chat)        shift; cmd_chat "$@" ;;
  new|n)       exec python3 "$WS/lib/new.py" ;;
  _footer)     ws_footer "${2:-}" ;;
  _model)      ws_model "${2:-}" ;;
  _style)      WS_SESSION="${2:?}"; ws_style ;;
  stats)       exec python3 "$WS/lib/stats.py" ;;
  monitor)     exec python3 "$WS/lib/monitor.py" "$@" ;;
  customize)   exec python3 "$WS/lib/customize.py" ;;
  s|sessions)  exec python3 "$WS/lib/sessions.py" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
